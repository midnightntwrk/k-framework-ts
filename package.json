{
  "name": "@kframework-ts/monorepo",
  "private": true,
  "description": "Unofficial TypeScript utilities for the K Framework",
  "license": "MIT OR Apache-2.0",
  "author": "Sebastien Guillemot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebastienGllmt/k-framework-ts.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun test",
    "check:types": "bun run --filter '*' check:types",
    "check:lint": "oxlint --type-aware",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "check": "bun run check:types && bun run check:lint && bun run fmt:check && bun test"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "^26.1.2",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "0.25.0",
    "typescript": "7.0.2",
    "zod": "4.6.6"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20"
  },
  "patchedDependencies": {
    "@stricli/core@1.3.0": "patches/@stricli%2Fcore@1.3.0.patch"
  }
}
