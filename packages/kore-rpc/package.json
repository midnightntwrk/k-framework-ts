{
  "name": "@kframework-ts/kore-rpc",
  "version": "0.1.0",
  "description": "Client and codec for kore-rpc — the JSON-RPC protocol of the haskell-backend's symbolic-execution servers (transcribed from kore-rpc-types at haskell-backend v0.1.155 / pyk at K v7.1.337)",
  "keywords": [
    "booster",
    "formal-verification",
    "haskell-backend",
    "json-rpc",
    "k-framework",
    "kore",
    "kore-rpc",
    "matching-logic",
    "pyk",
    "symbolic-execution"
  ],
  "homepage": "https://github.com/SebastienGllmt/k-framework-ts/tree/main/packages/kore-rpc#readme",
  "bugs": {
    "url": "https://github.com/SebastienGllmt/k-framework-ts/issues"
  },
  "license": "MIT OR Apache-2.0",
  "author": "Sebastien Guillemot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebastienGllmt/k-framework-ts.git",
    "directory": "packages/kore-rpc"
  },
  "bin": {
    "kore-rpc-ts": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./bugreport": {
      "types": "./dist/bugreport.d.ts",
      "import": "./dist/bugreport.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "bun test",
    "check:types": "tsc --noEmit",
    "check": "bun run check:types && bun test",
    "prepublishOnly": "bun run --cwd ../.. check && bun run build"
  },
  "dependencies": {
    "@kframework-ts/kore": "workspace:*",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.2"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20"
  }
}
