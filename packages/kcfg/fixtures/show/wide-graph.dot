digraph {
	"1" [label="1 (root, @start)" class="root @start"]
	"2" [label="2 (split, @apex)" class="split @apex"]
	"3" [label="3"]
	"4" [label="4"]
	"5" [label="5 (stuck, leaf)" class="stuck leaf"]
	"6" [label="6"]
	"7" [label="7 (leaf)" class="leaf"]
	"8" [label="8 (leaf)" class="leaf"]
	"9" [label="9 (root)" class="root"]
	"10" [label="10 (leaf)" class="leaf"]
	"11" [label="11 (root, leaf)" class="root leaf"]
	"1" -> "2" [label="  2 steps        "]
	"3" -> "6" [label="  1 steps        "]
	"6" -> "2" [label="  Y |-> 6        " class="abstraction" style="dashed"]
	"2" -> "3" [label="  #Equals(true, _>Int_(Y, 10))        "]
	"2" -> "4" [label="  #Equals(true, _>Int_(Y, 20))        "]
	"2" -> "5" [label="  #Equals(true, _>Int_(Y, 30))        "]
	"4" -> "7" [label="  1 step        "]
	"4" -> "8" [label="  1 step        "]
}
