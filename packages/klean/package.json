{
  "name": "@kframework-ts/klean",
  "version": "0.1.0",
  "description": "Compiled KORE to Lean 4 shallow-embedding generator (transcribed from pyk.klean at K v7.1.337)",
  "keywords": [
    "formal-verification",
    "k-framework",
    "klean",
    "kore",
    "lean",
    "lean4",
    "proof"
  ],
  "homepage": "https://github.com/SebastienGllmt/k-framework-ts/tree/main/packages/klean#readme",
  "bugs": {
    "url": "https://github.com/SebastienGllmt/k-framework-ts/issues"
  },
  "license": "MIT OR Apache-2.0",
  "author": "Sebastien Guillemot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebastienGllmt/k-framework-ts.git",
    "directory": "packages/klean"
  },
  "bin": {
    "klean": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "ROADMAP.md",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fs": {
      "types": "./dist/fs.d.ts",
      "import": "./dist/fs.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "bun test",
    "check:types": "tsc --noEmit",
    "check": "bun run check:types && bun test",
    "prepublishOnly": "bun run --cwd ../.. check && bun run build"
  },
  "dependencies": {
    "@kframework-ts/kore": "workspace:*",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@kframework-ts/wasm-fixtures": "workspace:*",
    "@types/node": "^26.1.2"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20"
  }
}
