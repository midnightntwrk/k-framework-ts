{
  "name": "@kframework-ts/ktool",
  "version": "0.1.0",
  "description": "Runs the K Framework binaries from TypeScript — kompile/krun/kast/kore-print argv construction and spawning, the LLVM interpreter, and the spec-claim index (transcribed from pyk at K v7.1.337)",
  "keywords": [
    "formal-verification",
    "k-framework",
    "kast",
    "kompile",
    "kompiled",
    "kore",
    "krun",
    "ktool",
    "pyk"
  ],
  "homepage": "https://github.com/SebastienGllmt/k-framework-ts/tree/main/packages/ktool#readme",
  "bugs": {
    "url": "https://github.com/SebastienGllmt/k-framework-ts/issues"
  },
  "license": "MIT OR Apache-2.0",
  "author": "Sebastien Guillemot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebastienGllmt/k-framework-ts.git",
    "directory": "packages/ktool"
  },
  "bin": {
    "ktool": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md",
    "ROADMAP.md",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "bun test",
    "check:types": "tsc --noEmit",
    "check": "bun run check:types && bun test",
    "prepublishOnly": "bun run --cwd ../.. check && bun run build"
  },
  "dependencies": {
    "@kframework-ts/bison": "workspace:*",
    "@kframework-ts/k-parser": "workspace:*",
    "@kframework-ts/kast": "workspace:*",
    "@kframework-ts/kast-json": "workspace:*",
    "@kframework-ts/kompiled": "workspace:*",
    "@kframework-ts/konvert": "workspace:*",
    "@kframework-ts/kore": "workspace:*",
    "@stricli/core": "^1.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@kframework-ts/wasm-fixtures": "workspace:*",
    "@types/node": "^26.1.2"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20"
  }
}
