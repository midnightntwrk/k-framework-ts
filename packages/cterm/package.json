{
  "name": "@kframework-ts/cterm",
  "version": "0.1.0",
  "description": "Immutable constrained KAST terms — CTerm and CSubst (transcribed from pyk at K v7.1.337)",
  "keywords": [
    "cterm",
    "formal-verification",
    "k-framework",
    "kast",
    "matching-logic",
    "pyk",
    "symbolic-execution"
  ],
  "homepage": "https://github.com/SebastienGllmt/k-framework-ts/tree/main/packages/cterm#readme",
  "bugs": {
    "url": "https://github.com/SebastienGllmt/k-framework-ts/issues"
  },
  "license": "MIT OR Apache-2.0",
  "author": "Sebastien Guillemot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebastienGllmt/k-framework-ts.git",
    "directory": "packages/cterm"
  },
  "bin": {
    "cterm": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./symbolic": {
      "types": "./dist/symbolic.d.ts",
      "import": "./dist/symbolic.js"
    },
    "./trace": {
      "types": "./dist/trace.d.ts",
      "import": "./dist/trace.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "bun test",
    "check:types": "tsc --noEmit",
    "check": "bun run check:types && bun test",
    "prepublishOnly": "bun run --cwd ../.. check && bun run build"
  },
  "dependencies": {
    "@kframework-ts/kast": "workspace:*",
    "@kframework-ts/konvert": "workspace:*",
    "@kframework-ts/kore": "workspace:*",
    "@kframework-ts/kore-rpc": "workspace:*"
  },
  "devDependencies": {
    "@kframework-ts/ktool": "workspace:*",
    "@types/node": "^26.1.2"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20"
  }
}
