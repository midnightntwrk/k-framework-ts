{
  "name": "@kframework-ts/kompiled",
  "version": "0.1.0",
  "description": "Reader for K Framework's *-kompiled/ directories — layout, compiled.json, definition.kore (transcribed from K v7.1.337)",
  "keywords": [
    "formal-verification",
    "k-framework",
    "kast",
    "kompile",
    "kompiled",
    "kore",
    "pretty-printer"
  ],
  "homepage": "https://github.com/SebastienGllmt/k-framework-ts/tree/main/packages/kompiled#readme",
  "bugs": {
    "url": "https://github.com/SebastienGllmt/k-framework-ts/issues"
  },
  "license": "MIT OR Apache-2.0",
  "author": "Sebastien Guillemot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebastienGllmt/k-framework-ts.git",
    "directory": "packages/kompiled"
  },
  "bin": {
    "kompiled": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "bun test",
    "check:types": "tsc --noEmit",
    "check": "bun run check:types && bun test",
    "prepublishOnly": "bun run --cwd ../.. check && bun run build"
  },
  "dependencies": {
    "@kframework-ts/kast": "workspace:*",
    "@kframework-ts/kore": "workspace:*"
  },
  "devDependencies": {
    "@kframework-ts/evm-fixtures": "workspace:*",
    "@kframework-ts/konvert": "workspace:*",
    "@kframework-ts/mir-fixtures": "workspace:*",
    "@kframework-ts/wasm-fixtures": "workspace:*",
    "@types/node": "^26.1.2"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20"
  }
}
