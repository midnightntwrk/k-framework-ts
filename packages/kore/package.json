{
  "name": "@kframework-ts/kore",
  "version": "0.1.0",
  "description": "Reader/writer for K Framework's KORE — the textual format and KORE-JSON (transcribed from K v7.1.337 / haskell-backend v0.1.155)",
  "keywords": [
    "formal-verification",
    "k-framework",
    "kompile",
    "kore",
    "kore-json",
    "kore-rpc",
    "matching-logic",
    "parser"
  ],
  "homepage": "https://github.com/SebastienGllmt/k-framework-ts/tree/main/packages/kore#readme",
  "bugs": {
    "url": "https://github.com/SebastienGllmt/k-framework-ts/issues"
  },
  "license": "MIT OR Apache-2.0",
  "author": "Sebastien Guillemot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebastienGllmt/k-framework-ts.git",
    "directory": "packages/kore"
  },
  "bin": {
    "kore": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./prelude": {
      "types": "./dist/prelude.d.ts",
      "import": "./dist/prelude.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "bun test",
    "check:types": "tsc --noEmit",
    "check": "bun run check:types && bun test",
    "prepublishOnly": "bun run --cwd ../.. check && bun run build"
  },
  "devDependencies": {
    "@kframework-ts/wasm-fixtures": "workspace:*",
    "ajv": "^8.20.0"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20"
  }
}
