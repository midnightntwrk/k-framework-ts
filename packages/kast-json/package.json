{
  "name": "@kframework-ts/kast-json",
  "version": "0.2.0",
  "description": "Reader for K Framework's KAST JSON versions 3 and 4 (transcribed from K v7.1.191 and v7.1.337)",
  "keywords": [
    "ast",
    "formal-verification",
    "k-framework",
    "kast",
    "kast-json",
    "kompile",
    "krun",
    "parser"
  ],
  "homepage": "https://github.com/SebastienGllmt/k-framework-ts/tree/main/packages/kast-json#readme",
  "bugs": {
    "url": "https://github.com/SebastienGllmt/k-framework-ts/issues"
  },
  "license": "MIT OR Apache-2.0",
  "author": "Sebastien Guillemot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebastienGllmt/k-framework-ts.git",
    "directory": "packages/kast-json"
  },
  "bin": {
    "kast-json": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "bun test",
    "check:types": "tsc --noEmit",
    "check": "bun run check:types && bun test",
    "prepublishOnly": "bun run --cwd ../.. check && bun run build"
  },
  "peerDependencies": {
    "zod": "^4.4.3"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20"
  }
}
