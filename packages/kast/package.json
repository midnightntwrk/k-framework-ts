{
  "name": "@kframework-ts/kast",
  "version": "0.1.0",
  "description": "The KAST term algebra — build, compare, match, substitute, and transform K terms (transcribed from pyk at K v7.1.337, KAST v4)",
  "keywords": [
    "ast",
    "formal-verification",
    "k-framework",
    "kast",
    "matching",
    "pyk",
    "rewriting",
    "term-algebra"
  ],
  "homepage": "https://github.com/SebastienGllmt/k-framework-ts/tree/main/packages/kast#readme",
  "bugs": {
    "url": "https://github.com/SebastienGllmt/k-framework-ts/issues"
  },
  "license": "MIT OR Apache-2.0",
  "author": "Sebastien Guillemot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebastienGllmt/k-framework-ts.git",
    "directory": "packages/kast"
  },
  "bin": {
    "kast-ts": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./prelude/*": {
      "types": "./dist/prelude/*.d.ts",
      "import": "./dist/prelude/*.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "bun test",
    "check:types": "tsc --noEmit",
    "check": "bun run check:types && bun test",
    "prepublishOnly": "bun run --cwd ../.. check && bun run build"
  },
  "devDependencies": {
    "@kframework-ts/wasm-fixtures": "workspace:*"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20"
  }
}
