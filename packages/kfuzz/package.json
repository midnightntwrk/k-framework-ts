{
  "name": "@kframework-ts/kfuzz",
  "version": "0.1.0",
  "description": "Property fuzzing over K semantics — fast-check arbitraries substituted into a KORE template and run through the LLVM interpreter (transcribed from pyk at K v7.1.337)",
  "keywords": [
    "fast-check",
    "formal-verification",
    "fuzzing",
    "k-framework",
    "kfuzz",
    "kore",
    "property-based-testing",
    "pyk"
  ],
  "homepage": "https://github.com/SebastienGllmt/k-framework-ts/tree/main/packages/kfuzz#readme",
  "bugs": {
    "url": "https://github.com/SebastienGllmt/k-framework-ts/issues"
  },
  "license": "MIT OR Apache-2.0",
  "author": "Sebastien Guillemot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebastienGllmt/k-framework-ts.git",
    "directory": "packages/kfuzz"
  },
  "bin": {
    "kfuzz": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "ROADMAP.md",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "bun test",
    "check:types": "tsc --noEmit",
    "check": "bun run check:types && bun test",
    "prepublishOnly": "bun run --cwd ../.. check && bun run build"
  },
  "dependencies": {
    "@kframework-ts/kore": "workspace:*",
    "@kframework-ts/ktool": "workspace:*",
    "fast-check": "^4.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20"
  }
}
